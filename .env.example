# Database Configuration
# Option 1: Full DATABASE_URL (takes precedence)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/football?sslmode=disable

# Option 2: Individual database parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=football
DB_SSLMODE=disable

# Server Configuration
PORT=8080

# Environment (development, production)
APP_ENV=development

# Optional: Additional settings
# LOG_LEVEL=info
